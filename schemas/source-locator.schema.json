{
  "$id": "urn:pastport:contract:0.1.0:source-locator",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "File Sha256",
      "type": "string"
    },
    "page_index": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Page Index"
    },
    "paragraph_or_region": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Paragraph Or Region"
    },
    "printed_page": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Printed Page"
    },
    "source_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Source Version",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_version",
    "file_sha256",
    "page_index",
    "printed_page",
    "paragraph_or_region"
  ],
  "title": "SourceLocator",
  "type": "object"
}
