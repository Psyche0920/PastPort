{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "source_manifest",
            "source_index",
            "candidate_set",
            "route",
            "evidence",
            "narrative",
            "runtime",
            "policy",
            "skill",
            "model_config",
            "requirements",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "kind",
        "schema_version",
        "content_version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CandidateScore": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "evidence",
            "visual",
            "character",
            "solvability",
            "spatial"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "maximum": 4,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "score",
        "reason"
      ],
      "title": "CandidateScore",
      "type": "object"
    },
    "CandidateSetDraft": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/StoryCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unresolved_items": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unresolved Items",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "content_version",
        "candidates",
        "unresolved_items"
      ],
      "title": "CandidateSetDraft",
      "type": "object"
    },
    "EvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "candidate_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "existing_source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Existing Source Ids",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "scope_gap",
            "direction"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "question": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Evidence",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "project_id",
        "purpose",
        "candidate_id",
        "question",
        "reason",
        "affected_ids",
        "existing_source_ids",
        "required_evidence"
      ],
      "title": "EvidenceRequest",
      "type": "object"
    },
    "StoryCandidate": {
      "additionalProperties": false,
      "properties": {
        "blocking_gaps": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Blocking Gaps",
          "type": "array"
        },
        "candidate_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "dimension_scores": {
          "items": {
            "$ref": "#/$defs/CandidateScore"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Dimension Scores",
          "type": "array"
        },
        "human_work_estimate_minutes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Human Work Estimate Minutes"
        },
        "premise": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Premise",
          "type": "string"
        },
        "proposed_player_actions": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Proposed Player Actions",
          "type": "array"
        },
        "recommendation_reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Recommendation Reason",
          "type": "string"
        },
        "reversal_conditions": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reversal Conditions",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "supported_opportunities": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Opportunities",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "premise",
        "source_refs",
        "supported_opportunities",
        "blocking_gaps",
        "proposed_player_actions",
        "human_work_estimate_minutes",
        "dimension_scores",
        "recommendation_reason",
        "reversal_conditions"
      ],
      "title": "StoryCandidate",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Id"
        },
        "code": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Code",
          "type": "string"
        },
        "json_pointer": {
          "pattern": "^(?:/.*)?$",
          "title": "Json Pointer",
          "type": "string"
        },
        "message": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "owner": {
          "enum": [
            "evidence",
            "narrative",
            "assembly",
            "runtime",
            "workflow"
          ],
          "title": "Owner",
          "type": "string"
        },
        "remediation": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Remediation",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "owner",
        "artifact_id",
        "json_pointer",
        "message",
        "remediation"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:discover-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Changed Ids",
      "type": "array"
    },
    "evidence_requests": {
      "items": {
        "$ref": "#/$defs/EvidenceRequest"
      },
      "title": "Evidence Requests",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "completed",
        "research_required",
        "changes_required",
        "blocked",
        "no_feasible_story"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateSetDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "maxLength": 10000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "payload",
    "issues",
    "evidence_requests",
    "changed_ids",
    "reason"
  ],
  "title": "ModuleResult[CandidateSetDraft]",
  "type": "object"
}
