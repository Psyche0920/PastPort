{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "source_manifest",
            "source_index",
            "candidate_set",
            "route",
            "evidence",
            "narrative",
            "runtime",
            "policy",
            "skill",
            "model_config",
            "requirements",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "kind",
        "schema_version",
        "content_version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "allowed_uses": {
          "items": {
            "enum": [
              "internal_preview",
              "public"
            ],
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        },
        "alt_text": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Alt Text",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "derivative_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivative Sha256",
          "type": "string"
        },
        "mapping_state": {
          "enum": [
            "unmapped",
            "provisional",
            "verified"
          ],
          "title": "Mapping State",
          "type": "string"
        },
        "original_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "rights_basis": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rights Basis",
          "type": "string"
        },
        "rights_state": {
          "enum": [
            "unknown",
            "restricted",
            "permitted_for_scope",
            "open_license"
          ],
          "title": "Rights State",
          "type": "string"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        },
        "source_locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "structure_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Structure Id"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "version",
        "original_sha256",
        "derivative_sha256",
        "source_locator",
        "site_id",
        "structure_id",
        "mapping_state",
        "rights_state",
        "allowed_uses",
        "rights_basis",
        "alt_text"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "approved_wording": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved Wording"
        },
        "claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "content_kind": {
          "enum": [
            "historical_fact",
            "interpretation",
            "original_fiction"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "judgment": {
          "enum": [
            "supported",
            "qualified",
            "conflicting",
            "insufficient"
          ],
          "title": "Judgment",
          "type": "string"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "refute": {
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "title": "Refute",
          "type": "array"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        },
        "structure_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Structure Id"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "title": "Support",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "time_scope": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Time Scope",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "version",
        "text",
        "site_id",
        "structure_id",
        "time_scope",
        "content_kind",
        "support",
        "refute",
        "judgment",
        "reason",
        "approved_wording"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "main",
            "optional",
            "deferred",
            "excluded"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "disposition",
        "reason"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "name"
      ],
      "title": "Site",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "acquisition_state": {
          "enum": [
            "discovered",
            "downloaded",
            "parsed",
            "failed"
          ],
          "title": "Acquisition State",
          "type": "string"
        },
        "extraction_state": {
          "enum": [
            "extracted",
            "needs_ocr",
            "checked",
            "failed"
          ],
          "title": "Extraction State",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "origin": {
          "enum": [
            "official",
            "external",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "uri": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "file_sha256",
        "origin",
        "title",
        "uri",
        "acquisition_state",
        "extraction_state"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "page_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index"
        },
        "paragraph_or_region": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paragraph Or Region"
        },
        "printed_page": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "file_sha256",
        "page_index",
        "printed_page",
        "paragraph_or_region"
      ],
      "title": "SourceLocator",
      "type": "object"
    },
    "SpatialEdge": {
      "additionalProperties": false,
      "properties": {
        "distance_metres": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distance Metres"
        },
        "edge_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "from_site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "From Site Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "to_site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "To Site Id",
          "type": "string"
        },
        "verification_state": {
          "enum": [
            "unknown",
            "verified"
          ],
          "title": "Verification State",
          "type": "string"
        },
        "walking_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Walking Seconds"
        }
      },
      "required": [
        "edge_id",
        "from_site_id",
        "to_site_id",
        "source_refs",
        "verification_state",
        "distance_metres",
        "walking_seconds"
      ],
      "title": "SpatialEdge",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "content_version": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Content Version",
      "type": "string"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Coverage",
      "type": "array"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "route_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Route Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "sites": {
      "items": {
        "$ref": "#/$defs/Site"
      },
      "minItems": 1,
      "title": "Sites",
      "type": "array"
    },
    "source_folder_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Source Folder Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "spatial_edges": {
      "items": {
        "$ref": "#/$defs/SpatialEdge"
      },
      "title": "Spatial Edges",
      "type": "array"
    },
    "unresolved_items": {
      "items": {
        "maxLength": 10000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "schema_version",
    "content_version",
    "source_folder_id",
    "scope",
    "sources",
    "sites",
    "claims",
    "assets",
    "spatial_edges",
    "route_refs",
    "coverage",
    "unresolved_items"
  ],
  "title": "EvidencePackage",
  "type": "object"
}
