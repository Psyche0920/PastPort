{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "source_manifest",
            "source_index",
            "candidate_set",
            "route",
            "evidence",
            "narrative",
            "runtime",
            "policy",
            "skill",
            "model_config",
            "requirements",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "kind",
        "schema_version",
        "content_version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ProjectRequirements": {
      "additionalProperties": false,
      "properties": {
        "accessibility_requirements": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Accessibility Requirements",
          "type": "array"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "distribution_scope": {
          "enum": [
            "internal_preview",
            "public"
          ],
          "title": "Distribution Scope",
          "type": "string"
        },
        "languages": {
          "items": {
            "enum": [
              "en",
              "zh"
            ],
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_site_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Site Ids"
        },
        "target_story_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Story Minutes"
        },
        "theme_brief": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme Brief",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "content_version",
        "scope_site_ids",
        "languages",
        "target_story_minutes",
        "theme_brief",
        "accessibility_requirements",
        "distribution_scope"
      ],
      "title": "ProjectRequirements",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "acquisition_state": {
          "enum": [
            "discovered",
            "downloaded",
            "parsed",
            "failed"
          ],
          "title": "Acquisition State",
          "type": "string"
        },
        "extraction_state": {
          "enum": [
            "extracted",
            "needs_ocr",
            "checked",
            "failed"
          ],
          "title": "Extraction State",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "origin": {
          "enum": [
            "official",
            "external",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "uri": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "file_sha256",
        "origin",
        "title",
        "uri",
        "acquisition_state",
        "extraction_state"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceManifestDraft": {
      "additionalProperties": false,
      "properties": {
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "failures": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Failures",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_folder_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Folder Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "content_version",
        "source_folder_id",
        "sources",
        "failures"
      ],
      "title": "SourceManifestDraft",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:index-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/SourceManifestDraft"
    },
    "requirements": {
      "$ref": "#/$defs/ProjectRequirements"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "source_refs",
    "requirements"
  ],
  "title": "IndexRequest",
  "type": "object"
}
