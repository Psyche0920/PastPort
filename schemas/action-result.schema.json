{
  "$defs": {
    "ActionReceipt": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "feedback_keys": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Feedback Keys",
          "type": "array"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "payload_hash",
        "feedback_keys",
        "event_ids"
      ],
      "title": "ActionReceipt",
      "type": "object"
    },
    "AddStoryTime": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "add_story_time",
          "title": "Kind",
          "type": "string"
        },
        "minutes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "minutes"
      ],
      "title": "AddStoryTime",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/AssignmentPair"
          },
          "title": "Pairs",
          "type": "array"
        },
        "task_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "pairs"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "AssignmentPair": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Card Id",
          "type": "string"
        },
        "destination_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Destination Id",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "destination_id"
      ],
      "title": "AssignmentPair",
      "type": "object"
    },
    "ChoiceState": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "option_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Option Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "option_id"
      ],
      "title": "ChoiceState",
      "type": "object"
    },
    "EvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "prop_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Prop Ids",
          "type": "array"
        },
        "task_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "prop_ids"
      ],
      "title": "EvidenceSelection",
      "type": "object"
    },
    "GameEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "spot_observed",
            "board_submitted",
            "option_chosen",
            "task_completed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "kind",
        "target_id"
      ],
      "title": "GameEvent",
      "type": "object"
    },
    "GrantItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "const": "grant_item",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item_id"
      ],
      "title": "GrantItem",
      "type": "object"
    },
    "ObservationSet": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "spot_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Spot Ids",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "spot_ids"
      ],
      "title": "ObservationSet",
      "type": "object"
    },
    "PlayerState": {
      "additionalProperties": false,
      "properties": {
        "applied_rule_keys": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Applied Rule Keys",
          "type": "array"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "chapter_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Chapter Id",
          "type": "string"
        },
        "completed_task_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Completed Task Ids",
          "type": "array"
        },
        "current_scene_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Current Scene Id",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ChoiceState"
          },
          "title": "Decisions",
          "type": "array"
        },
        "elapsed_minutes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Elapsed Minutes",
          "type": "integer"
        },
        "ending_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ending Id"
        },
        "inventory": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Inventory",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationSet"
          },
          "title": "Observations",
          "type": "array"
        },
        "package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Hash",
          "type": "string"
        },
        "processed_actions": {
          "items": {
            "$ref": "#/$defs/ActionReceipt"
          },
          "title": "Processed Actions",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "release_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Release Id",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSelection"
          },
          "title": "Selected Evidence",
          "type": "array"
        },
        "unlocked_scene_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Unlocked Scene Ids",
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableState"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "release_id",
        "package_hash",
        "chapter_id",
        "schema_version",
        "revision",
        "current_scene_id",
        "elapsed_minutes",
        "observations",
        "completed_task_ids",
        "decisions",
        "inventory",
        "assignments",
        "selected_evidence",
        "variables",
        "unlocked_scene_ids",
        "applied_rule_keys",
        "processed_actions",
        "ending_id"
      ],
      "title": "PlayerState",
      "type": "object"
    },
    "ResolveEnding": {
      "additionalProperties": false,
      "properties": {
        "ending_table_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Ending Table Id",
          "type": "string"
        },
        "kind": {
          "const": "resolve_ending",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ending_table_id"
      ],
      "title": "ResolveEnding",
      "type": "object"
    },
    "RuleTrace": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_story_time": "#/$defs/AddStoryTime",
                "grant_item": "#/$defs/GrantItem",
                "resolve_ending": "#/$defs/ResolveEnding",
                "set_relationship": "#/$defs/SetVariable",
                "set_variable": "#/$defs/SetVariable",
                "unlock_scene": "#/$defs/UnlockScene"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/GrantItem"
              },
              {
                "$ref": "#/$defs/SetVariable"
              },
              {
                "$ref": "#/$defs/AddStoryTime"
              },
              {
                "$ref": "#/$defs/UnlockScene"
              },
              {
                "$ref": "#/$defs/ResolveEnding"
              }
            ]
          },
          "title": "Effects",
          "type": "array"
        },
        "event_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "rule_id",
        "effects"
      ],
      "title": "RuleTrace",
      "type": "object"
    },
    "SetVariable": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "set_variable",
            "set_relationship"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maxLength": 10000,
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "name",
        "value"
      ],
      "title": "SetVariable",
      "type": "object"
    },
    "UnlockScene": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unlock_scene",
          "title": "Kind",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Scene Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "scene_id"
      ],
      "title": "UnlockScene",
      "type": "object"
    },
    "VariableState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maxLength": 10000,
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "VariableState",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:action-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "emitted_events": {
      "items": {
        "$ref": "#/$defs/GameEvent"
      },
      "title": "Emitted Events",
      "type": "array"
    },
    "feedback_keys": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Feedback Keys",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/PlayerState"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/RuleTrace"
      },
      "title": "Trace",
      "type": "array"
    }
  },
  "required": [
    "state",
    "emitted_events",
    "feedback_keys",
    "trace"
  ],
  "title": "ActionResult",
  "type": "object"
}
