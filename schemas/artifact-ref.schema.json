{
  "$id": "urn:pastport:contract:0.1.0:artifact-ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Artifact Id",
      "type": "string"
    },
    "content_version": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Content Version",
      "type": "string"
    },
    "kind": {
      "enum": [
        "source",
        "source_manifest",
        "source_index",
        "candidate_set",
        "route",
        "evidence",
        "narrative",
        "runtime",
        "policy",
        "skill",
        "model_config",
        "requirements",
        "report"
      ],
      "title": "Kind",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "project_id",
    "kind",
    "schema_version",
    "content_version",
    "sha256"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
