{
  "$id": "urn:pastport:contract:0.1.0:runtime-capabilities",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "condition_kinds": {
      "items": {
        "enum": [
          "all",
          "any",
          "not",
          "observed_all",
          "choice_equals",
          "variable_equals",
          "has_evidence",
          "elapsed_gt"
        ],
        "type": "string"
      },
      "title": "Condition Kinds",
      "type": "array"
    },
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "effect_kinds": {
      "items": {
        "enum": [
          "grant_item",
          "set_variable",
          "set_relationship",
          "add_story_time",
          "unlock_scene",
          "resolve_ending"
        ],
        "type": "string"
      },
      "title": "Effect Kinds",
      "type": "array"
    },
    "event_kinds": {
      "items": {
        "enum": [
          "spot_observed",
          "board_submitted",
          "option_chosen",
          "task_completed"
        ],
        "type": "string"
      },
      "title": "Event Kinds",
      "type": "array"
    },
    "locales": {
      "items": {
        "enum": [
          "en",
          "zh",
          "tr"
        ],
        "type": "string"
      },
      "title": "Locales",
      "type": "array"
    },
    "max_condition_depth": {
      "default": 8,
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Max Condition Depth",
      "type": "integer"
    },
    "max_effects_per_action": {
      "default": 64,
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Max Effects Per Action",
      "type": "integer"
    },
    "max_events_per_action": {
      "default": 2,
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Max Events Per Action",
      "type": "integer"
    },
    "profile": {
      "const": "t1a-single-task",
      "title": "Profile",
      "type": "string"
    },
    "task_kinds": {
      "items": {
        "enum": [
          "inspect",
          "caseboard"
        ],
        "type": "string"
      },
      "title": "Task Kinds",
      "type": "array"
    }
  },
  "required": [
    "profile",
    "contract_version",
    "task_kinds",
    "condition_kinds",
    "effect_kinds",
    "event_kinds",
    "locales"
  ],
  "title": "RuntimeCapabilities",
  "type": "object"
}
