{
  "$id": "urn:pastport:contract:0.1.0:evidence-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Affected Ids",
      "type": "array"
    },
    "candidate_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Id"
    },
    "existing_source_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Existing Source Ids",
      "type": "array"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "scope_gap",
        "direction"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "question": {
      "maxLength": 10000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Question",
      "type": "string"
    },
    "reason": {
      "maxLength": 10000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "required_evidence": {
      "items": {
        "maxLength": 10000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Evidence",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "project_id",
    "purpose",
    "candidate_id",
    "question",
    "reason",
    "affected_ids",
    "existing_source_ids",
    "required_evidence"
  ],
  "title": "EvidenceRequest",
  "type": "object"
}
