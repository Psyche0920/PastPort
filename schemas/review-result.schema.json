{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "source_manifest",
            "source_index",
            "candidate_set",
            "route",
            "evidence",
            "narrative",
            "runtime",
            "policy",
            "skill",
            "model_config",
            "requirements",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "kind",
        "schema_version",
        "content_version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "candidate_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "existing_source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Existing Source Ids",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "scope_gap",
            "direction"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "question": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Evidence",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "project_id",
        "purpose",
        "candidate_id",
        "question",
        "reason",
        "affected_ids",
        "existing_source_ids",
        "required_evidence"
      ],
      "title": "EvidenceRequest",
      "type": "object"
    },
    "NarrativeReview": {
      "additionalProperties": false,
      "properties": {
        "counterexamples": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Counterexamples",
          "type": "array"
        },
        "human_review_required": {
          "const": true,
          "title": "Human Review Required",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "narrative_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "narrative_ref",
        "issues",
        "counterexamples",
        "human_review_required"
      ],
      "title": "NarrativeReview",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Id"
        },
        "code": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Code",
          "type": "string"
        },
        "json_pointer": {
          "pattern": "^(?:/.*)?$",
          "title": "Json Pointer",
          "type": "string"
        },
        "message": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "owner": {
          "enum": [
            "evidence",
            "narrative",
            "assembly",
            "runtime",
            "workflow"
          ],
          "title": "Owner",
          "type": "string"
        },
        "remediation": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Remediation",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "owner",
        "artifact_id",
        "json_pointer",
        "message",
        "remediation"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:review-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Changed Ids",
      "type": "array"
    },
    "evidence_requests": {
      "items": {
        "$ref": "#/$defs/EvidenceRequest"
      },
      "title": "Evidence Requests",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "completed",
        "research_required",
        "changes_required",
        "blocked",
        "no_feasible_story"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrativeReview"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "maxLength": 10000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "payload",
    "issues",
    "evidence_requests",
    "changed_ids",
    "reason"
  ],
  "title": "ModuleResult[NarrativeReview]",
  "type": "object"
}
