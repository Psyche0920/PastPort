{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "source_manifest",
            "source_index",
            "candidate_set",
            "route",
            "evidence",
            "narrative",
            "runtime",
            "policy",
            "skill",
            "model_config",
            "requirements",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "kind",
        "schema_version",
        "content_version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FolderInput": {
      "additionalProperties": false,
      "properties": {
        "folder_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Folder Id",
          "type": "string"
        },
        "manifest_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "enum": [
            "google_drive",
            "local_manifest"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "folder_id",
        "manifest_ref"
      ],
      "title": "FolderInput",
      "type": "object"
    },
    "ProjectRequirements": {
      "additionalProperties": false,
      "properties": {
        "accessibility_requirements": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Accessibility Requirements",
          "type": "array"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "distribution_scope": {
          "enum": [
            "internal_preview",
            "public"
          ],
          "title": "Distribution Scope",
          "type": "string"
        },
        "languages": {
          "items": {
            "enum": [
              "en",
              "zh",
              "tr"
            ],
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_site_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Site Ids"
        },
        "target_story_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Story Minutes"
        },
        "theme_brief": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme Brief",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "content_version",
        "scope_site_ids",
        "languages",
        "target_story_minutes",
        "theme_brief",
        "accessibility_requirements",
        "distribution_scope"
      ],
      "title": "ProjectRequirements",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:inventory-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "folder": {
      "$ref": "#/$defs/FolderInput"
    },
    "policy_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "requirements": {
      "$ref": "#/$defs/ProjectRequirements"
    }
  },
  "required": [
    "folder",
    "requirements",
    "policy_ref"
  ],
  "title": "InventoryRequest",
  "type": "object"
}
