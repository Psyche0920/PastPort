        "kind": {
          "const": "choose",
          "title": "Kind",
          "type": "string"
        },
        "option_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Option Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_revision",
        "target_id",
        "kind",
        "option_id"
      ],
      "title": "Choose",
      "type": "object"
    },
    "Observe": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "observe",
          "title": "Kind",
          "type": "string"
        },
        "spot_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Spot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
