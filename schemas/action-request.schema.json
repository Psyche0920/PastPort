{
  "$defs": {
    "Advance": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "advance",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_revision",
        "target_id",
        "kind"
      ],
      "title": "Advance",
      "type": "object"
    },
    "Choose": {
