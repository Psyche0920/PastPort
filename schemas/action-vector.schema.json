{
  "$defs": {
    "ActionReceipt": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "feedback_keys": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Feedback Keys",
          "type": "array"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "payload_hash",
        "feedback_keys",
        "event_ids"
      ],
      "title": "ActionReceipt",
      "type": "object"
    },
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "advance": "#/$defs/Advance",
              "choose": "#/$defs/Choose",
              "observe": "#/$defs/Observe",
              "submit_evidence": "#/$defs/SubmitEvidence"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Observe"
            },
            {
              "$ref": "#/$defs/Choose"
            },
            {
              "$ref": "#/$defs/SubmitEvidence"
            },
            {
              "$ref": "#/$defs/Advance"
            }
          ],
          "title": "Action"
        },
        "package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Hash",
          "type": "string"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "release_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "release_id",
        "package_hash",
        "action"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "Advance": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "advance",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_revision",
        "target_id",
        "kind"
      ],
      "title": "Advance",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "pairs": {
          "items": {
            "$ref": "#/$defs/AssignmentPair"
          },
          "title": "Pairs",
          "type": "array"
        },
        "task_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "pairs"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "AssignmentPair": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Card Id",
          "type": "string"
        },
        "destination_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Destination Id",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "destination_id"
      ],
      "title": "AssignmentPair",
      "type": "object"
    },
    "ChoiceState": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "option_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Option Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "option_id"
      ],
      "title": "ChoiceState",
      "type": "object"
    },
    "Choose": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "choose",
          "title": "Kind",
          "type": "string"
        },
        "option_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Option Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_revision",
        "target_id",
        "kind",
        "option_id"
      ],
      "title": "Choose",
      "type": "object"
    },
    "EvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "prop_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Prop Ids",
          "type": "array"
        },
        "task_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "prop_ids"
      ],
      "title": "EvidenceSelection",
      "type": "object"
    },
    "ObservationSet": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "spot_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Spot Ids",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "spot_ids"
      ],
      "title": "ObservationSet",
      "type": "object"
    },
    "Observe": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "observe",
          "title": "Kind",
          "type": "string"
        },
        "spot_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Spot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_revision",
        "target_id",
        "kind",
        "spot_id"
      ],
      "title": "Observe",
      "type": "object"
    },
    "PlayerState": {
      "additionalProperties": false,
      "properties": {
        "applied_rule_keys": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Applied Rule Keys",
          "type": "array"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "chapter_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Chapter Id",
          "type": "string"
        },
        "completed_task_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Completed Task Ids",
          "type": "array"
        },
        "current_scene_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Current Scene Id",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ChoiceState"
          },
          "title": "Decisions",
          "type": "array"
        },
        "elapsed_minutes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Elapsed Minutes",
          "type": "integer"
        },
        "ending_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ending Id"
        },
        "inventory": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Inventory",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationSet"
          },
          "title": "Observations",
          "type": "array"
        },
        "package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Hash",
          "type": "string"
        },
        "processed_actions": {
          "items": {
            "$ref": "#/$defs/ActionReceipt"
          },
          "title": "Processed Actions",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "release_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Release Id",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSelection"
          },
          "title": "Selected Evidence",
          "type": "array"
        },
        "unlocked_scene_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Unlocked Scene Ids",
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/VariableState"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "release_id",
        "package_hash",
        "chapter_id",
        "schema_version",
        "revision",
        "current_scene_id",
        "elapsed_minutes",
        "observations",
        "completed_task_ids",
        "decisions",
        "inventory",
        "assignments",
        "selected_evidence",
        "variables",
        "unlocked_scene_ids",
        "applied_rule_keys",
        "processed_actions",
        "ending_id"
      ],
      "title": "PlayerState",
      "type": "object"
    },
    "SubmitEvidence": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "kind": {
          "const": "submit_evidence",
          "title": "Kind",
          "type": "string"
        },
        "prop_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Prop Ids",
          "type": "array"
        },
        "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_revision",
        "target_id",
        "kind",
        "prop_ids"
      ],
      "title": "SubmitEvidence",
      "type": "object"
    },
    "VariableState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maxLength": 10000,
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "VariableState",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:action-vector",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionRequest"
      },
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "category": {
      "enum": [
        "success",
        "idempotency",
        "stale_revision",
        "effect_conflict",
        "locked_scene"
      ],
      "title": "Category",
      "type": "string"
    },
    "evaluation_status": {
      "const": "not_run",
      "title": "Evaluation Status",
      "type": "string"
    },
    "expected_error": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Error"
    },
    "expected_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlayerState"
        },
        {
          "type": "null"
        }
      ]
    },
    "initial_state": {
      "$ref": "#/$defs/PlayerState"
    },
    "vector_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Vector Id",
      "type": "string"
    }
  },
  "required": [
    "vector_id",
    "category",
    "initial_state",
    "actions",
    "expected_state",
    "expected_error",
    "evaluation_status"
  ],
  "title": "ActionVector",
  "type": "object"
}
