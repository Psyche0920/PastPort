{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "allowed_uses": {
          "items": {
            "enum": [
              "internal_preview",
              "public"
            ],
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        },
        "alt_text": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Alt Text",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "derivative_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivative Sha256",
          "type": "string"
        },
        "mapping_state": {
          "enum": [
            "unmapped",
            "provisional",
            "verified"
          ],
          "title": "Mapping State",
          "type": "string"
        },
        "original_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "rights_basis": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rights Basis",
          "type": "string"
        },
        "rights_state": {
          "enum": [
            "unknown",
            "restricted",
            "permitted_for_scope",
            "open_license"
          ],
          "title": "Rights State",
          "type": "string"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        },
        "source_locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "structure_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Structure Id"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "version",
        "original_sha256",
        "derivative_sha256",
        "source_locator",
        "site_id",
        "structure_id",
        "mapping_state",
        "rights_state",
        "allowed_uses",
        "rights_basis",
        "alt_text"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "approved_wording": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved Wording"
        },
        "claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "content_kind": {
          "enum": [
            "historical_fact",
            "interpretation",
            "original_fiction"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "judgment": {
          "enum": [
            "supported",
            "qualified",
            "conflicting",
            "insufficient"
          ],
          "title": "Judgment",
          "type": "string"
        },
        "reason": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "refute": {
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "title": "Refute",
          "type": "array"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        },
        "structure_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Structure Id"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "title": "Support",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "time_scope": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Time Scope",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "version",
        "text",
        "site_id",
        "structure_id",
        "time_scope",
        "content_kind",
        "support",
        "refute",
        "judgment",
        "reason",
        "approved_wording"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ProjectRequirements": {
      "additionalProperties": false,
      "properties": {
        "accessibility_requirements": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Accessibility Requirements",
          "type": "array"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "distribution_scope": {
          "enum": [
            "internal_preview",
            "public"
          ],
          "title": "Distribution Scope",
          "type": "string"
        },
        "languages": {
          "items": {
            "enum": [
              "en",
              "zh"
            ],
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_site_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Site Ids"
        },
        "target_story_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Story Minutes"
        },
        "theme_brief": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme Brief",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "content_version",
        "scope_site_ids",
        "languages",
        "target_story_minutes",
        "theme_brief",
        "accessibility_requirements",
        "distribution_scope"
      ],
      "title": "ProjectRequirements",
      "type": "object"
    },
    "RuntimeCapabilities": {
      "additionalProperties": false,
      "properties": {
        "condition_kinds": {
          "items": {
            "enum": [
              "all",
              "any",
              "not",
              "observed_all",
              "choice_equals",
              "variable_equals",
              "has_evidence",
              "elapsed_gt"
            ],
            "type": "string"
          },
          "title": "Condition Kinds",
          "type": "array"
        },
        "contract_version": {
          "const": "0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "effect_kinds": {
          "items": {
            "enum": [
              "grant_item",
              "set_variable",
              "set_relationship",
              "add_story_time",
              "unlock_scene",
              "resolve_ending"
            ],
            "type": "string"
          },
          "title": "Effect Kinds",
          "type": "array"
        },
        "event_kinds": {
          "items": {
            "enum": [
              "spot_observed",
              "board_submitted",
              "option_chosen",
              "task_completed"
            ],
            "type": "string"
          },
          "title": "Event Kinds",
          "type": "array"
        },
        "locales": {
          "items": {
            "enum": [
              "en",
              "zh"
            ],
            "type": "string"
          },
          "title": "Locales",
          "type": "array"
        },
        "max_condition_depth": {
          "default": 8,
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Max Condition Depth",
          "type": "integer"
        },
        "max_effects_per_action": {
          "default": 64,
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Max Effects Per Action",
          "type": "integer"
        },
        "max_events_per_action": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Max Events Per Action",
          "type": "integer"
        },
        "profile": {
          "const": "t1a-single-task",
          "title": "Profile",
          "type": "string"
        },
        "task_kinds": {
          "items": {
            "enum": [
              "inspect",
              "caseboard"
            ],
            "type": "string"
          },
          "title": "Task Kinds",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "contract_version",
        "task_kinds",
        "condition_kinds",
        "effect_kinds",
        "event_kinds",
        "locales"
      ],
      "title": "RuntimeCapabilities",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "site_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "name"
      ],
      "title": "Site",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "acquisition_state": {
          "enum": [
            "discovered",
            "downloaded",
            "parsed",
            "failed"
          ],
          "title": "Acquisition State",
          "type": "string"
        },
        "extraction_state": {
          "enum": [
            "extracted",
            "needs_ocr",
            "checked",
            "failed"
          ],
          "title": "Extraction State",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "origin": {
          "enum": [
            "official",
            "external",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "uri": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version",
        "file_sha256",
        "origin",
        "title",
        "uri",
        "acquisition_state",
        "extraction_state"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceIndexDraft": {
      "additionalProperties": false,
      "properties": {
        "candidate_assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Candidate Assets",
          "type": "array"
        },
        "candidate_claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Candidate Claims",
          "type": "array"
        },
        "content_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Content Version",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "title": "Fragments",
          "type": "array"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/Site"
          },
          "title": "Sites",
          "type": "array"
        },
        "source_folder_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Folder Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "unresolved_items": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unresolved Items",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "content_version",
        "source_folder_id",
        "sources",
        "sites",
        "candidate_claims",
        "candidate_assets",
        "fragments",
        "unresolved_items"
      ],
      "title": "SourceIndexDraft",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "page_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index"
        },
        "paragraph_or_region": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paragraph Or Region"
        },
        "printed_page": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "file_sha256",
        "page_index",
        "printed_page",
        "paragraph_or_region"
      ],
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "$id": "urn:pastport:contract:0.1.0:discover-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "index": {
      "$ref": "#/$defs/SourceIndexDraft"
    },
    "requirements": {
      "$ref": "#/$defs/ProjectRequirements"
    },
    "runtime_capabilities": {
      "$ref": "#/$defs/RuntimeCapabilities"
    }
  },
  "required": [
    "index",
    "requirements",
    "runtime_capabilities"
  ],
  "title": "DiscoverRequest",
  "type": "object"
}
