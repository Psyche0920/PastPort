{
  "$id": "urn:pastport:contract:0.1.0:tool-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "lookup_local",
        "search_web",
        "read_source"
      ],
      "title": "Kind",
      "type": "string"
    },
    "limit": {
      "maximum": 5,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "query": {
      "anyOf": [
        {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Query"
    },
    "question_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Question Id",
      "type": "string"
    },
    "site_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Site Ids",
      "type": "array"
    },
    "source_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Id"
    }
  },
  "required": [
    "kind",
    "question_id",
    "query",
    "source_id",
    "site_ids",
    "limit"
  ],
  "title": "ToolRequest",
  "type": "object"
}
