        },
        "title": {
          "$ref": "#/$defs/StoryText"
        },
        "view_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "View Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "claim_ids",
        "view_id",
        "title",
        "dialogue",
        "objective",
        "feedback",
        "hints",
        "accessibility",
        "gameplay",
        "reasoning"
      ],
      "title": "StoryPlanTask",
      "type": "object"
