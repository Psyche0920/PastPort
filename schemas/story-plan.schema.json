{
  "$defs": {
    "CoveragePlan": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Capability Id",
          "type": "string"
        },
        "fiction_notice": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fiction Notice",
          "type": "string"
        },
        "kind": {
          "const": "coverage",
          "title": "Kind",
          "type": "string"
        },
        "learning_goal": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Learning Goal",
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/CoverageProblem"
        },
        "source_requirement": {
          "$ref": "#/$defs/SourceChoiceRequirement"
        }
      },
      "required": [
        "kind",
        "capability_id",
        "rules",
        "source_requirement",
        "learning_goal",
        "fiction_notice"
      ],
      "title": "CoveragePlan",
      "type": "object"
    },
    "CoverageProblem": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 8,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "pieces": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 8,
                "minimum": 1,
                "type": "integer"
              },
              {
                "maximum": 8,
                "minimum": 1,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Pieces",
          "type": "array"
        },
        "rotation_allowed": {
          "default": true,
          "title": "Rotation Allowed",
          "type": "boolean"
        },
        "width": {
          "maximum": 8,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "pieces"
      ],
      "title": "CoverageProblem",
      "type": "object"
    },
    "DifferenceDesign": {
      "additionalProperties": false,
      "properties": {
        "content_kind": {
          "enum": [
            "original_fiction",
            "source_attributed"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "differences": {
          "items": {
            "$ref": "#/$defs/ImageDifference"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Differences",
          "type": "array"
        },
        "kind": {
          "const": "spot-difference",
          "title": "Kind",
          "type": "string"
        },
        "left_image": {
          "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(svg|png|jpg|jpeg|webp)$",
          "title": "Left Image",
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/LocalizedCopy"
        },
        "right_image": {
          "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(svg|png|jpg|jpeg|webp)$",
          "title": "Right Image",
          "type": "string"
        },
        "success": {
          "$ref": "#/$defs/LocalizedCopy"
        }
      },
      "required": [
        "prompt",
        "success",
        "content_kind",
        "kind",
        "left_image",
        "right_image",
        "differences"
      ],
      "title": "DifferenceDesign",
      "type": "object"
    },
    "ImageDifference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/LocalizedCopy"
        },
        "left": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Left",
          "type": "array"
        },
        "right": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Right",
          "type": "array"
        }
      },
      "required": [
        "id",
        "left",
        "right",
        "label"
      ],
      "title": "ImageDifference",
      "type": "object"
    },
    "ImagePuzzleDesign": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "maximum": 4,
          "minimum": 2,
          "title": "Columns",
          "type": "integer"
        },
        "content_kind": {
          "enum": [
            "original_fiction",
            "source_attributed"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/PuzzleImages"
        },
        "kind": {
          "const": "image-puzzle",
          "title": "Kind",
          "type": "string"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/PuzzlePiece"
          },
          "maxItems": 12,
          "minItems": 4,
          "title": "Pieces",
          "type": "array"
        },
        "prompt": {
          "$ref": "#/$defs/LocalizedCopy"
        },
        "rows": {
          "maximum": 3,
          "minimum": 2,
          "title": "Rows",
          "type": "integer"
        },
        "success": {
          "$ref": "#/$defs/LocalizedCopy"
        }
      },
      "required": [
        "prompt",
        "success",
        "content_kind",
        "kind",
        "image",
        "columns",
        "rows",
        "pieces"
      ],
      "title": "ImagePuzzleDesign",
      "type": "object"
    },
    "InvestigationDesign": {
      "additionalProperties": false,
      "properties": {
        "asset_manifest": {
          "items": {
            "$ref": "#/$defs/InvestigationImage"
          },
          "maxItems": 16,
          "title": "Asset Manifest",
          "type": "array"
        },
        "interludes": {
          "items": {
            "$ref": "#/$defs/InvestigationInterlude"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Interludes",
          "type": "array"
        }
      },
      "required": [
        "asset_manifest",
        "interludes"
      ],
      "title": "InvestigationDesign",
      "type": "object"
    },
    "InvestigationImage": {
      "additionalProperties": false,
      "properties": {
        "content_kind": {
          "enum": [
            "original_fiction",
            "source_attributed"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "path": {
          "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(svg|png|jpg|jpeg|webp)$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_claim_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "sha256",
        "content_kind",
        "source_claim_ids"
      ],
      "title": "InvestigationImage",
      "type": "object"
    },
    "InvestigationInterlude": {
      "additionalProperties": false,
      "properties": {
        "after_task": {
          "maximum": 18,
          "minimum": 1,
          "title": "After Task",
          "type": "integer"
        },
        "body": {
          "$ref": "#/$defs/LocalizedCopy"
        },
        "objective": {
          "$ref": "#/$defs/LocalizedCopy"
        },
        "opening_lines": {
          "items": {
            "$ref": "#/$defs/InvestigationLine"
          },
          "maxItems": 12,
          "title": "Opening Lines",
          "type": "array"
        },
        "plugin": {
          "discriminator": {
            "mapping": {
              "image-puzzle": "#/$defs/ImagePuzzleDesign",
              "scene-search": "#/$defs/SceneSearchDesign",
              "spot-difference": "#/$defs/DifferenceDesign",
              "timeline": "#/$defs/TimelineDesign"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DifferenceDesign"
            },
            {
              "$ref": "#/$defs/TimelineDesign"
            },
            {
              "$ref": "#/$defs/ImagePuzzleDesign"
            },
            {
              "$ref": "#/$defs/SceneSearchDesign"
            }
          ],
          "title": "Plugin"
        },
        "required_sources": {
          "items": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Required Sources",
          "type": "array"
        },
        "reward": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedCopy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_object": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Source Object",
          "type": "integer"
        },
        "title": {
          "$ref": "#/$defs/LocalizedCopy"
        }
      },
      "required": [
        "after_task",
        "source_object",
        "required_sources",
        "title",
        "body",
        "objective",
        "opening_lines",
        "plugin"
      ],
      "title": "InvestigationInterlude",
      "type": "object"
    },
    "InvestigationLine": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/LocalizedCopy"
        }
      },
      "required": [
        "speaker",
        "text"
      ],
      "title": "InvestigationLine",
      "type": "object"
    },
    "LocalizedCopy": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "En",
          "type": "string"
        },
        "zh": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Zh",
          "type": "string"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "title": "LocalizedCopy",
      "type": "object"
    },
    "OpeningPerson": {
      "additionalProperties": false,
      "description": "Public opening introduction; runtime character identities are not model-authored.",
      "properties": {
        "introduction": {
          "$ref": "#/$defs/StoryText"
        },
        "name": {
          "$ref": "#/$defs/StoryText"
        }
      },
      "required": [
        "name",
        "introduction"
      ],
      "title": "OpeningPerson",
      "type": "object"
    },
    "OpeningStation": {
      "additionalProperties": false,
