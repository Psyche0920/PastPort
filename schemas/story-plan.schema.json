          "$ref": "#/$defs/StoryText"
        },
        "title": {
          "$ref": "#/$defs/StoryText"
        }
      },
      "required": [
        "asset_id",
        "title",
        "purpose"
      ],
      "title": "OpeningStation",
      "type": "object"
    },
    "PuzzleImages": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(svg|png|jpg|jpeg|webp)$",
          "title": "En",
          "type": "string"
        },
        "zh": {
          "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(svg|png|jpg|jpeg|webp)$",
          "title": "Zh",
          "type": "string"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "title": "PuzzleImages",
      "type": "object"
    },
    "PuzzlePiece": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "target_slot": {
          "maximum": 11,
          "minimum": 0,
          "title": "Target Slot",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "target_slot"
      ],
      "title": "PuzzlePiece",
      "type": "object"
    },
    "ReadingPlan": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "source_reading",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
