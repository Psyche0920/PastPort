      ],
      "title": "SceneSearchDesign",
      "type": "object"
    },
    "SearchTarget": {
      "additionalProperties": false,
      "properties": {
        "clue": {
          "$ref": "#/$defs/LocalizedCopy"
        },
        "number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "clue"
      ],
      "title": "SearchTarget",
      "type": "object"
    },
    "SourceChoiceRequirement": {
      "additionalProperties": false,
      "properties": {
        "contrast_claim_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Contrast Claim Ids",
          "type": "array"
        },
        "target_claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Claim Id",
          "type": "string"
        }
      },
      "required": [
        "target_claim_id",
        "contrast_claim_ids"
      ],
      "title": "SourceChoiceRequirement",
      "type": "object"
    },
    "StoryOpening": {
      "additionalProperties": false,
      "description": "Only information available before investigation, not the hidden solution.",
