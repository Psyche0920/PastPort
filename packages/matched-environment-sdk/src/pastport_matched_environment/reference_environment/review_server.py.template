"""Serve the local comparison dataset and record explicit review decisions."""
from __future__ import annotations
import json
import mimetypes
import sqlite3
import shutil
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Iterator
from urllib.parse import urlparse, parse_qs
from vr_content import VRContentEdit, VRContentService
from vr_positions import PositionEdit, VRPositionService

ROOT = Path(__file__).resolve().parent
CONTENT_DATABASE = ROOT / "pastport_matching.sqlite3"
PORT = 8793
VR_CONTENT = VRContentService(ROOT / "pastport_matching.sqlite3")
VR_POSITIONS = VRPositionService(ROOT / 'pastport_matching.sqlite3', ROOT / 'vr_trial/trial_report.json')

from pastport_matched_environment.application.review_repository import (
    Review, ReviewRepository as SharedReviewRepository,
)

class ReviewRepository(SharedReviewRepository):
    """The preview assigns the validated authority before serving requests."""
    def __init__(self) -> None:
        super().__init__(CONTENT_DATABASE)

    @contextmanager
    def connection(self) -> Iterator[sqlite3.Connection]:
        self.database = CONTENT_DATABASE
        with super().connection() as connection:
            yield connection

class ReviewHandler(BaseHTTPRequestHandler):
    repository = ReviewRepository()

    def send_bytes(self, status: int, payload: bytes, content_type: str) -> None:
        self.send_response(status)
        self.send_header('Content-Type',content_type)
        self.send_header('Content-Length',str(len(payload)))
        self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Cache-Control','no-store')
        self.end_headers()
        self.wfile.write(payload)

    def send_file(self, path: Path) -> None:
        try:
            stream = path.open('rb')
        except OSError:
            self.send_error(503, 'File temporarily unavailable')
            return
        with stream:
            self.send_response(200)
            self.send_header('Content-Type', mimetypes.guess_type(str(path))[0] or 'application/octet-stream')
            self.send_header('Content-Length', str(path.stat().st_size))
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            try:
                shutil.copyfileobj(stream, self.wfile, length=65536)
            except OSError as error:
                self.close_connection = True
                self.log_error('Static transfer interrupted (%s)', type(error).__name__)

    def do_GET(self) -> None:
        route = urlparse(self.path).path
        if route == '/api/vr-positions':
            try:
                result = VRPositionService.encode(VR_POSITIONS.current())
            except (OSError, ValueError, sqlite3.Error):
                self.send_error(503, 'Position data unavailable')
                return
            self.send_bytes(200, result.encode(), 'application/json; charset=utf-8')
            return
        if route=='/api/vr-content':
            try:
                oid=int(parse_qs(urlparse(self.path).query).get('object_id',[''])[0])
                content=VR_CONTENT.read(oid)
            except (ValueError, IndexError):
                self.send_error(400,'Invalid object ID')
                return
            except sqlite3.Error:
                self.send_error(503,'VR content unavailable')
                return
            if content is None:
                self.send_error(404,'No current VR content; object may be unlocated or remapped')
                return
            self.send_bytes(200,content.json().encode(),'application/json; charset=utf-8')
            return
        if route=='/api/data':
            self.send_bytes(200,self.repository.dataset().encode(),'application/json; charset=utf-8')
            return
        relative = 'index.html' if route=='/' else route.lstrip('/')
        path = (ROOT / relative).resolve()
        if ROOT not in path.parents or not path.is_file() or path.suffix not in ('.html','.pdf','.jpg','.png','.sqlite3','.csv','.json','.md','.sql','.js'):
            self.send_error(404)
            return
        self.send_file(path)

    def do_POST(self) -> None:
        origin = self.headers.get('Origin')
        if self.path not in ('/api/review','/api/vr-content','/api/vr-positions') or origin not in (f'http://127.0.0.1:{PORT}',f'http://localhost:{PORT}'):
            self.send_error(403)
            return
        try:
            length = int(self.headers.get('Content-Length','0'))
            if length<1 or length>16000:
                raise ValueError('Invalid payload size')
            payload=json.loads(self.rfile.read(length))
            if self.path == '/api/vr-positions':
                position = VR_POSITIONS.save(PositionEdit.parse(payload))
                self.send_bytes(200 if position else 409,
                    VRPositionService.encode((position,)).encode() if position else b'[]',
                    'application/json; charset=utf-8')
                return
            if self.path=='/api/vr-content':
                success=VR_CONTENT.save(VRContentEdit.parse(payload))
            else:
                review = Review.parse(payload)
                success = self.repository.save(review)
        except (ValueError, json.JSONDecodeError):
            self.send_error(400,'Invalid review data')
            return
        except sqlite3.Error:
            self.send_error(503,'Database write failed; review was not saved')
            return
        self.send_bytes(200 if success else 409,json.dumps({'saved':success}).encode(),'application/json')

if __name__=='__main__':
    # This is an initialized reference snapshot; do not regenerate baseline records.
    with ThreadingHTTPServer(('127.0.0.1',PORT),ReviewHandler) as server:
        print(f'Local review: http://127.0.0.1:{PORT}',flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
