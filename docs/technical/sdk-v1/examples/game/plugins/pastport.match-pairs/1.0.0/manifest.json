    {
      "path": "plugins/pastport.match-pairs/1.0.0/logic.mjs",
      "role": "logic",
      "sha256": "64673c116ff227873ed85e6ffe21fc1da1edca737dd05b27aab1c5be92f4b1b9",
      "size_bytes": 3178
    },
    {
      "path": "plugins/pastport.match-pairs/1.0.0/view.mjs",
      "role": "view",
      "sha256": "fc35922b052bd2f4bbd1d7aac2591a190796971468db5775e186141b914017c8",
      "size_bytes": 1622
    }
  ]
}
